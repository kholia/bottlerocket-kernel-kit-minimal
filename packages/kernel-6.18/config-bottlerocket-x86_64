# Architecture-specific configurations for x86_64

# x86_64-specific EFI support
CONFIG_EFI_MIXED=y

# x86_64 production hardening
CONFIG_X86_USER_SHADOW_STACK=y
CONFIG_MITIGATION_SLS=y

# x86_64-specific virtualization
CONFIG_HYPERVISOR_GUEST=y
CONFIG_XEN=y
CONFIG_XEN_PVHVM=y
CONFIG_XEN_PVHVM_SMP=y
CONFIG_XEN_PVHVM_GUEST=y
CONFIG_XEN_PVH=y
CONFIG_XEN_BLKDEV_FRONTEND=y
CONFIG_XEN_NETDEV_FRONTEND=y
CONFIG_XEN_XENBUS_FRONTEND=y
CONFIG_XEN_EFI=y

# x86_64-specific Xen backend control
# CONFIG_XEN_BACKEND is not set

# x86_64-specific SCSI frontend
# CONFIG_XEN_SCSI_FRONTEND is not set

# x86_64-specific VMware support
CONFIG_VMWARE_PVSCSI=y

# GPU-less target.
# CONFIG_DRM is not set
# CONFIG_DRM_I915 is not set
