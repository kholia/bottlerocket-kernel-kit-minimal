# Hard exclusions for the minimal Bottlerocket kernel.
#
# Keep these last in the merge order so that neither the Amazon Linux base
# config nor Bottlerocket compatibility restores can re-enable them.

# Module loading is intentionally unavailable.  This removes the runtime module
# loader and forces required kernel features to be compiled into vmlinux.
# CONFIG_MODULES is not set
# CONFIG_MODULE_UNLOAD is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_MODVERSIONS is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set

# The container runtime does not require unprivileged user namespaces, and they
# materially expand the kernel attack surface.
# CONFIG_USER_NS is not set

# Checkpoint/restore support is not part of Bottlerocket's supported host
# contract and pulls in process introspection helpers we do not need.
# CONFIG_CHECKPOINT_RESTORE is not set

# io_uring is a large async I/O subsystem with a history of security-sensitive
# bugs. Keep the classic AIO/poll/eventfd interfaces for workload compatibility.
# CONFIG_IO_URING is not set
# CONFIG_IO_URING_MOCK_FILE is not set
# CONFIG_IO_URING_ZCRX is not set
# CONFIG_IO_URING_BPF is not set
# CONFIG_FUSE_IO_URING is not set
# CONFIG_IO_WQ is not set

# The BPF preload module is sample infrastructure; Bottlerocket needs BPF
# runtime support for networking/observability, not a preloaded example object.
# CONFIG_BPF_PRELOAD is not set

# Production built-in hardening. These checks and randomization features are
# safe for the Bottlerocket host contract and avoid debug-only or
# compatibility-sensitive options such as free-time heap zeroing, randstruct,
# static usermodehelper routing, and enforced page-table checking.
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_BUCKETS=y
CONFIG_RANDOM_KMALLOC_CACHES=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_HARDENED_USERCOPY_DEFAULT_ON=y
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_DEBUG_WX=y
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y

